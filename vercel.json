{
    "buildCommand": "npm run build",
    "devCommand": "npm run dev",
    "installCommand": "npm install && cd backend && npm install && cd ..",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        }
    ],
    "env": {
        "MONGODB_URI": "@mongodb_uri",
        "NODE_ENV": "production",
        "CORS_ORIGIN": "@cors_origin",
        "VITE_API_URL": "/api"
    },
    "functions": {
        "api/index.js": {
            "maxDuration": 30
        }
    }
}