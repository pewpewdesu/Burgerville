{
    "buildCommand": "npm run build",
    "devCommand": "npm run dev",
    "installCommand": "npm install && cd backend && npm install && cd ..",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        }
    ],
    "env": [
        "MONGODB_URI",
        "NODE_ENV",
        "CORS_ORIGIN",
        "VITE_API_URL"
    ],
    "functions": {
        "api/index.js": {
            "maxDuration": 30
        }
    }
}